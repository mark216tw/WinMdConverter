<Window x:Class="WinMdConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Markdown 文件轉換器" Height="700" Width="880"
        MinHeight="610" MinWidth="740" Background="{StaticResource CanvasBrush}"
        Icon="Assets/WinMdConverter.ico"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="26,18,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="M A R K D O W N   D E S K" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="文件轉換器" FontFamily="Microsoft JhengHei UI" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,1" />
            <TextBlock Text="選擇文件並設定輸出，不顯示預覽，直接完成轉換。" Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsPanel">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="來源與輸出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,11" />
                        <TextBlock Text="Markdown 檔案" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputPathBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="選擇檔案" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseInput_Click" />
                        </Grid>

                        <TextBlock Text="輸出資料夾" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPathBox" />
                            <Button Grid.Column="1" Content="選擇資料夾" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseOutput_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="輸出格式" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                            <CheckBox x:Name="HtmlCheckBox" Content="HTML" IsChecked="True" VerticalAlignment="Center" Margin="0,0,22,0" />
                            <CheckBox x:Name="PdfCheckBox" Content="PDF" IsChecked="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="文件設定" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,11" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows 字型" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="FontComboBox" IsTextSearchEnabled="True" MaxDropDownHeight="300" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="紙張方向" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="OrientationComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="直向" />
                                    <ComboBoxItem Content="橫向" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="縮放比例" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ScaleModeComboBox" SelectedIndex="0" SelectionChanged="ScaleMode_Changed">
                                        <ComboBoxItem Content="符合可列印區域" />
                                        <ComboBoxItem Content="自訂" />
                                    </ComboBox>
                                    <TextBox x:Name="ScaleBox" Grid.Column="1" Text="100" IsEnabled="False" Margin="8,0,0,0" ToolTip="50 到 200%" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="邊界" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="MarginModeComboBox" SelectedIndex="0" SelectionChanged="MarginMode_Changed">
                                    <ComboBoxItem Content="預設（20 mm）" />
                                    <ComboBoxItem Content="無" />
                                    <ComboBoxItem Content="最小值（5 mm）" />
                                    <ComboBoxItem Content="自訂" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CustomMarginsPanel" Margin="0,9,0,0" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="上（mm）" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="MarginTopBox" Text="20" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="右（mm）" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="MarginRightBox" Text="20" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="下（mm）" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="MarginBottomBox" Text="20" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="左（mm）" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="MarginLeftBox" Text="20" /></StackPanel>
                        </Grid>

                        <CheckBox x:Name="TocCheckBox" Content="在文件開頭顯示目錄" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#EAF1EF" BorderBrush="#C8DAD6" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="尚未開始" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <ProgressBar x:Name="ConversionProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}" Background="#D5E2DF" />
                        <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="ResultLinksPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button x:Name="OpenHtmlButton" Content="開啟 HTML" Style="{StaticResource LinkButton}" Click="OpenHtml_Click" />
                            <Button x:Name="OpenPdfButton" Content="開啟 PDF" Style="{StaticResource LinkButton}" Click="OpenPdf_Click" />
                            <Button Content="開啟輸出資料夾" Style="{StaticResource LinkButton}" Click="OpenFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="A4 · Windows 10/11 · 本機離線轉換" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="結束" Style="{StaticResource SecondaryButton}" MinWidth="110" MinHeight="42" FontSize="14" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="ConvertButton" Grid.Column="2" Content="開始轉換" Style="{StaticResource PrimaryButton}" MinWidth="155" MinHeight="42" FontSize="14" Click="Convert_Click" />
        </Grid>
    </Grid>
</Window>
